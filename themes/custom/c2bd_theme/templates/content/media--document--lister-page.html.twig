{#
/**
 * @file
 * Theme override to display a media item.
 *
 * Available variables:
 * - name: Name of the media.
 * - content: Media content.
 *
 * @see template_preprocess_media()
 *
 * @ingroup themeable
 */
#}

{% set classes = [
  'media',
  'media--type-' ~ media.bundle()|clean_class,
  not media.isPublished() ? 'media--unpublished',
  view_mode ? 'media--view-mode-' ~ view_mode|clean_class,
] %}
<article{{ attributes.addClass(classes)|without('role', 'lang', 'dir') }}>
  {{ title_suffix.contextual_links }}
  {% if content %}
  {% if content.field_highlighted.0['#markup'] == 'On' %}
    {% set high_class = 'highlighted' %}
  {% else %}
    {% set high_class = '' %}
  {% endif %}
    <div class="media-wrapper {{ high_class }}">
      <div class="left thumbnail">
        {{ content.thumbnail }}
      </div>
      <div class="right">
        <div class="title">
          {{ content.name }}
        </div>
        <div class="subtitle">
          {% set cat_id = content.field_category.0['#options'].entity.id %}
          {% set cat_url = path('view.search.resources', {'category': cat_id}) %}
          {% set cat_title = content.field_category.0['#options'].entity.name.value %}
          <span class="created"> {{ content.created }} {% if content.field_category %}|{% endif %} </span>
          <span class="category">
            <a href="{{ cat_url }}" class="category-link">{{ cat_title }}</a>
          </span>
        </div>
        {% set text = content.field_lead.0['#context'].value %}
        {{ text|length > 200 ? text|slice(0, 300) ~ '...' : text }}
        {{ content.field_tags }}

        <a href="{{ content.name.0['#url'] }}" class="read-more"> {{ 'Read more'|t }} </a>
      </div>
    </div>
  {% endif %}
</article>
